PUBLIC_PLAY_URL=

# Yasal sayfalar: yayıncı (veri sorumlusu) adı ve iletişim adresi. Mağazaya göndermeden önce doldurulmalı.
PUBLIC_PUBLISHER_NAME=

# İletişim adresi ve kanonik site adresi
PUBLIC_CONTACT_EMAIL=
PUBLIC_SITE_URL=

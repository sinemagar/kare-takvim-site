# Supabase — yalnızca PUBLISHABLE key (sb_publishable_...). Secret key ASLA buraya konmaz.
# Boş bırakılırsa site açıkça etiketlenmiş yerel demo veriyle çalışır.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mağaza bağlantıları (yayınlanınca)

---
// Günlük yaprak iskeleti. İçeriği src/scripts/day-page.ts doldurur.
// Tüm metin seçilebilir DOM metnidir; görseller yalnızca dekorasyondur.
// Özel günlerde (millî/dinî) gün rakamı ve özel gün başlığı script tarafından renkli bandın içine taşınır.
import { NOTE_MAX_LENGTH } from '../lib/notes';
---

<div class="pad">
  <div class="pad-sheet pad-sheet--far" aria-hidden="true"></div>
  <div class="pad-sheet pad-sheet--near" aria-hidden="true"></div>
  <article class="leaf" aria-labelledby="leaf-title" data-leaf aria-busy="true">
    <header class="band">
      <span class="hole hole--l" aria-hidden="true"></span>
      <span class="hole hole--r" aria-hidden="true"></span>
      <nav class="band-nav" aria-label="Tarih gezinme">
        <button type="button" class="band-btn" data-prev aria-label="Önceki gün">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="band-title">
          <h1 id="leaf-title">
            <span class="visually-hidden" data-long>Günün yaprağı</span>
            <span aria-hidden="true" class="band-month" data-month-year>&nbsp;</span>
          </h1>
          <p class="band-weekday" aria-hidden="true" data-weekday>&nbsp;</p>
        </div>
        <button type="button" class="band-btn" data-next aria-label="Sonraki gün">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <span class="band-date">
          <button type="button" class="band-btn" data-date-open aria-label="Tarih seç">
            <svg width="21" height="21" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
          <input type="date" class="band-date-input" data-date-input tabindex="-1" aria-hidden="true" />
        </span>
      </nav>
      <div class="band-body" data-band-body></div>
    </header>
    <div class="perf" aria-hidden="true"></div>

    <div class="leaf-body" data-leaf-body>
      <section class="hero" data-hero aria-hidden="true">
        <p class="day-number" data-day-number>&nbsp;</p>
        <p class="hero-line">
          <span class="hero-month" data-hero-month>&nbsp;</span>
          <span class="hero-dot">•</span>
          <span class="hero-weekday" data-hero-weekday></span>
        </p>
        <p class="hero-rule caps" data-progress>&nbsp;</p>
      </section>

      <button type="button" class="btn today-btn" data-today hidden>Bugüne dön</button>

      <section class="special" data-special hidden aria-labelledby="special-title">
        <p class="pill caps" data-special-label></p>
        <h2 class="special-title" id="special-title" data-special-title></h2>
        <p class="special-summary" data-special-summary></p>
        <p class="memorial" data-memorial hidden aria-label="Saat dokuzu beş geçe"><span aria-hidden="true">09:05</span></p>
        <div data-special-sources></div>
      </section>

      <img class="page-art" data-page-art alt="" hidden width="1200" height="675" decoding="async" />

      <section class="card event" aria-labelledby="event-label" data-event>
        <div class="event-row">
          <div class="event-main">
            <p class="caps eyebrow" id="event-label">&nbsp;</p>
            <div data-event-head>
              <div class="skeleton skeleton--title"></div>
            </div>
          </div>
          <img class="spot" data-spot alt="" hidden width="288" height="288" decoding="async" />
        </div>
        <div data-event-body>
          <div class="skeleton"></div>
          <div class="skeleton skeleton--short"></div>
        </div>
      </section>

      <figure class="quote" data-quote hidden>
        <span class="quote-mark" aria-hidden="true">“</span>
        <div>
          <figcaption class="visually-hidden">Günün sözü</figcaption>
          <blockquote><p data-quote-text></p></blockquote>
          <p class="quote-source" data-quote-source></p>
        </div>
      </figure>

      <hr class="rule" />

      <section class="card sun" aria-labelledby="sun-label">
        <h2 class="visually-hidden" id="sun-label">Güneş saatleri</h2>
        <div class="sun-row">
          <button type="button" class="city-btn" data-city-open aria-haspopup="dialog">
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="sun-icon"><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <span class="visually-hidden">Şehir: </span><span class="city-name" data-city-name>İstanbul</span>
            <span class="city-change" aria-hidden="true">değiştir</span>
          </button>
          <dl class="sun-times">
            <div><dt>Doğuş</dt><dd data-sunrise>--:--</dd></div>
            <div><dt>Batış</dt><dd data-sunset>--:--</dd></div>
          </dl>
        </div>
        <svg class="sun-arc" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true">
          <path d="M8 21 Q150 -10 292 21" fill="none" stroke="var(--c-line)" stroke-width="1.8" stroke-dasharray="3,4" vector-effect="non-scaling-stroke"></path>
          <path data-arc-done fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></path>
        </svg>
        <span class="sun-dot" data-sun-dot hidden></span>
      </section>

      <p class="status" role="status" aria-live="polite" data-status></p>

      <div class="perf perf--soft" aria-hidden="true"></div>
      <section class="note" aria-labelledby="note-label" data-note>
        <div class="note-head">
          <h2 id="note-label" class="caps note-label">Bu güne notun</h2>
          <span class="note-badge">Yalnızca bu tarayıcıda</span>
        </div>
        <div class="note-paper" data-note-view hidden>
          <p class="note-text" data-note-text></p>
          <div class="note-actions">
            <button type="button" class="btn btn--ghost" data-note-delete>Sil</button>
            <button type="button" class="btn" data-note-edit>Düzenle</button>
          </div>
        </div>
        <form class="note-paper" data-note-form>
          <label for="note-input" class="visually-hidden">Bu güne not</label>
          <textarea id="note-input" rows="3" maxlength={NOTE_MAX_LENGTH} placeholder="Bu güne kısa bir not yaz…" data-note-input></textarea>
          <div class="note-actions">
            <p class="note-privacy">Notun sunucuya gönderilmez. <a href="/gizlilik">Ayrıntılar</a></p>
            <button type="button" class="btn btn--ghost" data-note-cancel hidden>Vazgeç</button>
            <button type="submit" class="btn btn--primary">Kaydet</button>
          </div>
        </form>
      </section>

      <p class="demo-badge" data-demo-badge hidden>Demo içerik — editoryal kontrolden geçmedi</p>

      <footer class="leaf-foot">
        <span class="brand"><img src="/favicon.png" alt="" width="24" height="24" />KareTakvim</span>
        <a href="/hakkinda" class="foot-link">Hakkında</a>
      </footer>
    </div>
  </article>
</div>

<dialog class="city-dialog" data-city-dialog aria-labelledby="city-dialog-title">
  <form method="dialog" class="city-dialog-inner">
    <div class="city-dialog-head">
      <h2 id="city-dialog-title">Şehir seç</h2>
      <button class="btn btn--ghost" value="cancel">Kapat</button>
    </div>
    <p class="city-hint">Güneş saatleri seçtiğin il merkezine göre hesaplanır. Konum izni istenmez.</p>
    <label for="city-search" class="visually-hidden">Şehir ara</label>
    <input id="city-search" type="search" placeholder="Şehir ara…" autocomplete="off" data-city-search />
    <ul class="city-list" data-city-list></ul>
  </form>
</dialog>
